{
  // Runtime configuration consumed by Cloudflare Pages deployments.
  // This file does not install or run a local deployment tool.
  "name": "campuscompile",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "BREVO_LIST_ID": "5",
    "ALLOWED_ORIGIN": "https://campuscompile.eu",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEqXvMiUSzMnHwvy"
  },

  "env": {
    "preview": {
      "vars": {
        "BREVO_LIST_ID": "6",
        "ALLOWED_ORIGIN": "https://campuscompile.eu/",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEqXvMiUSzMnHwvy"
      }
    }
  }
}
